---
// Permanent URL for a superseded version: /posts/<slug>/v<n>
import IntentPage from "../../../components/IntentPage.astro";
import { getOldPosts, type IntentPage as Page } from "../../../lib/intents";

export function getStaticPaths() {
  return getOldPosts().map((page) => ({
    params: { slug: page.file.name, version: String(page.file.version) },
    props: { page },
  }));
}

const { page } = Astro.props as { page: Page };
---

<IntentPage page={page} title={`${page.headline} (v${page.file.version}) · mohamadreza.com`} />
