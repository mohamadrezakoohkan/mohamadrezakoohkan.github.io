---
// src/pages/index.astro
// ─────────────────────────────────────────────────────────────
// HOME PAGE – Lists every blog post, newest first.
//
// How data fetching works in Astro:
//   The code inside the `---` fence runs at **build time** only.
//   Astro calls `getCollection("blog")` to load every entry in
//   the "blog" content collection, then we sort them by date.
//   The resulting HTML is a fully static .html file – zero JS
//   is shipped to the browser.
// ─────────────────────────────────────────────────────────────
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// 1. Fetch all entries from the "blog" content collection.
//    Each entry has `id` (filename-based slug), `data` (typed
//    frontmatter), and a `render()` method.
const allPosts = await getCollection("blog");

// 2. Sort posts by date – newest first.
//    Since `date` was coerced to a Date object in our schema,
//    we can compare them directly with getTime().
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Home – My Blog" description="A minimal personal blog built with Astro.">
  <section class="hero">
    <h1>Welcome to My Blog</h1>
    <p>Thoughts on web development, simplicity, and building things from scratch.</p>
  </section>

  <!-- ── Post list ─────────────────────────────────────────── -->
  <!--
    We loop over sorted posts with Astro's template syntax.
    `post.id` is derived from the filename (e.g. "hello-world"
    from "hello-world.md") and serves as the URL slug.
  -->
  <ul class="post-list">
    {
      sortedPosts.map((post) => (
        <li class="post-card">
          <a href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
            <h2>{post.data.title}</h2>
            <p class="post-description">{post.data.description}</p>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  /* ── Hero section ────────────────────────────────────────── */
  .hero {
    margin-bottom: 2.5rem;
  }
  .hero h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .hero p {
    color: #555;
    font-size: 1.1rem;
  }

  /* ── Post list ───────────────────────────────────────────── */
  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card a {
    display: block;
    padding: 1.25rem;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .post-card a:hover {
    text-decoration: none;
    border-color: #0056b3;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .post-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.3rem;
  }

  .post-description {
    color: #555;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .post-card time {
    font-size: 0.8rem;
    color: #888;
  }
</style>
